# Copy this file to .env and fill in real values. Every variable
# below is read directly by src/config/env.ts - nothing here is
# invented, and nothing env.ts reads is missing from this file.

# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
MONGODB_URI="mongodb://127.0.0.1:27017/ryuzen"

# ---- Auth ----
JWT_SECRET=change-this-to-a-real-random-secret
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ---- AI ----
# Selects which provider every AI feature uses (chat, resume review,
# career score, mock interview, recommendations, skill extraction).
# "gemini" (default) needs GEMINI_API_KEY set below. "ollama" runs
# fully locally - no API key needed, but requires Ollama itself
# running at OLLAMA_BASE_URL with OLLAMA_MODEL pulled.
AI_PROVIDER=gemini

# Required if AI_PROVIDER=gemini. Get a real key from
# https://aistudio.google.com/apikey (free tier available). This is
# the exact cause of "Gemini API key missing" errors - that error
# means this line is empty or missing entirely.
GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.5-flash

# Only used if AI_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ---- Cache ----
CACHE_DEFAULT_TTL_SECONDS=60

# ---- Email (invitations, verification, password reset) ----
# The app starts fine without these set - EmailService logs a
# warning and skips sending rather than crashing a request.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="RyuZen <no-reply@ryuzen.ai>"

FRONTEND_URL=http://localhost:5173

# ---- Account lockout ----
ACCOUNT_LOCK_THRESHOLD=5
ACCOUNT_LOCK_DURATION_MS=900000
